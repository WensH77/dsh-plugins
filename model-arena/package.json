{
  "name": "dsh-plugin-model-arena",
  "version": "0.5.3",
  "description": "dsh web 模型竞技场·挑战模式：空会话 hero 视图旁显示「竞技场」toggle，开启后选择场景（知识沉淀/测试用例）与竞技场模型；用户提问一次后输入框锁定，流程自动执行 模型1回答 → 模型2质疑 → 模型1修正 → 模型2终评（4 步收尾），模型2 的质疑/终评以用户消息注入主对话（原生渲染），角色/禁止辩论指令按场景注入，结束后解锁可提新一轮。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "locale",
        "sessions",
        "modelDirectories",
        "remote",
        "slots"
      ],
      "immediately": false
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/client-smoke.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.7"
  },
  "license": "MIT"
}
