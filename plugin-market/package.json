{
  "name": "dsh-plugin-market",
  "description": "dsh 版本状态灯：侧边栏 DeepSeek Harness 下方显示已装 dsh 版本与更新状态（启动 + 每小时检测 deepseek-harness 最新发布版本），点击跑本地插件契约扫描 + LLM 逐版本分析，判断新版本是否影响本机已装插件的运行期兼容性（原「插件市场」的设置页 tab 与安装/更新/卸载功能已在 0.16.0 移除）",
  "version": "0.16.0",
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "license": "MIT",
  "repository": "WensH77/dsh-plugins#path:plugin-market",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    }
  }
}
